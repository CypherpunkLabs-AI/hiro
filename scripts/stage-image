#!/usr/bin/env python3
"""Embed the verified proxy and exact release into the read-only OS build."""
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
from hiro import ROOT, validate


def run(*args, **kw):
    return subprocess.run(args, check=True, **kw)


lock, _ = validate(strict=True)
entry = lock['services']['hiro-proxy']
reference = entry['image'] + '@' + entry['digest']
dest = ROOT / 'image/mkosi.extra/usr/lib/hiro'
dest.mkdir(parents=True, exist_ok=True)
run('docker', 'pull', '--platform=linux/amd64', reference)
info = json.loads(subprocess.check_output(['docker', 'image', 'inspect', reference]))[0]
if reference not in info.get('RepoDigests', []) or info['Architecture'] != 'amd64':
    raise SystemExit('Pulled container does not match the pinned Linux amd64 image')
run('docker', 'save', '--output', str(dest / 'proxy.tar'), reference)
(dest / 'proxy-image-id').write_text(info['Id'] + '\n')
for name in ['release.json', 'compose.yaml', 'images.lock.json']:
    shutil.copyfile(ROOT / 'dist' / name, dest / name)
shutil.copyfile(ROOT / '.env.example', dest / 'runtime.env')
revision = (ROOT / 'image/tdx-tools-revision').read_text().strip()
if len(revision) != 40 or any(c not in '0123456789abcdef' for c in revision):
    raise SystemExit('Invalid TDX tools revision')
tools = ROOT / 'dist/tools'
tools.mkdir(parents=True, exist_ok=True)
env = dict(os.environ, GOBIN=str(tools), CGO_ENABLED='0')
run('go', 'install', 'github.com/google/go-tdx-guest/tools/extend@' + revision, env=env)
run('go', 'install', 'github.com/google/go-tdx-guest/tools/check@' + revision, env=env)
shutil.copyfile(tools / 'extend', dest / 'tdx-extend')
os.chmod(dest / 'tdx-extend', 0o755)
assets = {}
for path in sorted(dest.iterdir()):
    if path.name == 'assets.json':
        continue
    with path.open('rb') as f:
        assets[path.name] = hashlib.file_digest(f, 'sha256').hexdigest()
(dest / 'assets.json').write_text(json.dumps(assets, sort_keys=True, indent=2) + '\n')
print('Embedded ' + reference + ' as ' + info['Id'])
