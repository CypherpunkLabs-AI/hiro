#!/usr/bin/env python3
"""Import verified proxy metadata from a successful CI run or versioned release."""
import argparse
import json
from pathlib import Path
import subprocess
import sys
import tempfile
import time
from hiro import ROOT, PROFILE, matches, read, require, write


def gh_json(*arguments):
    return json.loads(subprocess.check_output(["gh", *arguments], text=True))


def publishing_run(repository, commit, wait_seconds):
    deadline = time.monotonic() + wait_seconds
    query = f"repos/{repository}/actions/workflows/ci.yml/runs?branch=main&event=push&head_sha={commit}&per_page=1"
    while True:
        runs = gh_json("api", query)["workflow_runs"]
        if runs:
            run = runs[0]
            require(run["head_sha"] == commit, "proxy run does not match the required commit")
            if run["status"] == "completed":
                require(run["conclusion"] == "success", f"proxy CI failed: {run['html_url']}")
                return run["id"]
        remaining = deadline - time.monotonic()
        require(remaining > 0, f"no successful proxy publishing run for {commit} within the wait limit")
        print(f"Waiting for proxy commit {commit} to finish publishing", flush=True)
        time.sleep(min(20, remaining))


def verify(subject, repository, commit, ref, bundle=None):
    command = ["gh", "attestation", "verify", subject, "--repo", repository,
               "--signer-workflow", repository + "/.github/workflows/ci.yml",
               "--signer-digest", commit, "--source-digest", commit, "--source-ref", ref,
               "--predicate-type", "https://slsa.dev/provenance/v1", "--deny-self-hosted-runners"]
    if bundle:
        command.extend(["--bundle", str(bundle)])
    subprocess.run(command, check=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    source = parser.add_mutually_exclusive_group()
    source.add_argument("--run", type=int, help="successful main-branch CI run; defaults to latest")
    source.add_argument("--release", help="published version, e.g. v0.1.0")
    parser.add_argument("--commit", help="require this exact proxy source commit")
    parser.add_argument("--wait", type=int, default=0, metavar="SECONDS",
                        help="wait for the required commit's publishing run")
    parser.add_argument("--check", action="store_true")
    args = parser.parse_args()
    require(args.commit is None or matches(args.commit, r"[0-9a-f]{40}"), "invalid required proxy commit")
    require(0 <= args.wait <= 3600, "wait must be between 0 and 3600 seconds")
    require(not args.wait or (args.commit and args.run is None and args.release is None),
            "--wait requires --commit without --run or --release")
    lock = read("images.lock.json")
    expected = lock["services"]["hiro-proxy"]
    repository = expected["source_repository"]
    require(matches(repository, r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+"), "invalid source repository")
    with tempfile.TemporaryDirectory(prefix="hiro-image-") as directory:
        path = Path(directory)
        if args.release:
            require(matches(args.release, r"v[0-9]+\.[0-9]+\.[0-9]+(?:-[A-Za-z0-9.-]+)?"), "invalid version")
            release = gh_json("api", f"repos/{repository}/releases/tags/{args.release}")
            require(not release["draft"] and release["tag_name"] == args.release, "release is not published")
            commit = gh_json("api", f"repos/{repository}/commits/{args.release}")["sha"]
            ref = "refs/tags/" + args.release
            subprocess.run(["gh", "release", "download", args.release, "--repo", repository,
                            "--pattern", "images.lock*", "--dir", directory], check=True)
        else:
            if args.run is None:
                if args.commit:
                    args.run = publishing_run(repository, args.commit, args.wait)
                else:
                    runs = gh_json("api", f"repos/{repository}/actions/workflows/ci.yml/runs?branch=main&event=push&status=success&per_page=1")["workflow_runs"]
                    require(bool(runs), "no successful proxy publishing run")
                    args.run = runs[0]["id"]
            require(args.run > 0, "invalid run ID")
            run = gh_json("api", f"repos/{repository}/actions/runs/{args.run}")
            require(run["status"] == "completed" and run["conclusion"] == "success", "proxy CI must succeed")
            require(run["event"] == "push" and run["head_branch"] == "main" and run["path"] == ".github/workflows/ci.yml", "unexpected publishing workflow")
            require(run["repository"]["full_name"].lower() == repository.lower(), "unexpected repository")
            commit, ref = run["head_sha"], "refs/heads/main"
            require(args.commit is None or commit == args.commit, "proxy run does not match the required commit")
            subprocess.run(["gh", "run", "download", str(args.run), "--repo", repository, "--name",
                            f"hiro-proxy-image-{commit}-{run['run_attempt']}", "--dir", directory], check=True)
        require(matches(commit, r"[0-9a-f]{40}"), "invalid source revision")
        require(args.commit is None or commit == args.commit, "proxy release does not match the required commit")
        verify(str(path / "images.lock.json"), repository, commit, ref, path / "images.lock.sigstore.json")
        published = json.loads((path / "images.lock.json").read_text())
        require(published.get("schema") == 1 and set(published["services"]) == {"hiro-proxy"}, "unexpected image lock")
        image = published["services"]["hiro-proxy"]
        require(image["image"] == expected["image"] and image["source_repository"].lower() == repository.lower(), "unexpected image identity")
        require(image["source_commit"] == image["workflow_commit"] == commit and image["source_ref"] == ref
                and image["build_workflow"] == ".github/workflows/ci.yml", "unexpected build identity")
        require(image.get("runtime_profile") == PROFILE, "image uses an incompatible runtime profile")
        require(matches(image["digest"], r"sha256:[0-9a-f]{64}"), "invalid OCI digest")
        verify("oci://" + image["image"] + "@" + image["digest"], repository, commit, ref)
        if args.check:
            require(image == expected, "published image differs from committed lock")
            print("Published image matches the committed lock")
            return
        lock["services"]["hiro-proxy"] = image
        temporary = ROOT / "images.lock.json.tmp"
        try:
            write(temporary, lock)
            temporary.replace(ROOT / "images.lock.json")
        finally:
            temporary.unlink(missing_ok=True)
        print(f"Locked {image['image']}@{image['digest']}")


if __name__ == "__main__":
    try:
        main()
    except (ValueError, KeyError, OSError, subprocess.CalledProcessError) as error:
        print(f"error: {error}", file=sys.stderr)
        sys.exit(1)
