#!/usr/bin/env python3
"""Import the signed image lock from a successful proxy CI run."""
import argparse
import json
from pathlib import Path
import subprocess
import sys
import tempfile

from hiro import ROOT, matches, read, require, write


def gh_json(*arguments):
    return json.loads(subprocess.check_output(["gh", *arguments], text=True))


def verify(subject, repository, commit, bundle=None):
    command = [
        "gh", "attestation", "verify", subject, "--repo", repository,
        "--signer-workflow", repository + "/.github/workflows/ci.yml",
        "--signer-digest", commit, "--source-digest", commit,
        "--source-ref", "refs/heads/main",
        "--predicate-type", "https://slsa.dev/provenance/v1",
        "--deny-self-hosted-runners",
    ]
    if bundle:
        command.extend(["--bundle", str(bundle)])
    subprocess.run(command, check=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--run", type=int, help="successful proxy Actions run ID; defaults to latest successful main push")
    args = parser.parse_args()
    lock = read("images.lock.json")
    expected = lock["services"]["hiro-proxy"]
    repository = expected["source_repository"]
    require(matches(repository, r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+"), "invalid source repository")
    if args.run is None:
        runs = gh_json("api", f"repos/{repository}/actions/workflows/ci.yml/runs"
                       "?branch=main&event=push&status=success&per_page=1")["workflow_runs"]
        require(bool(runs), "no successful proxy publishing run found")
        args.run = runs[0]["id"]
    require(args.run > 0, "run ID must be positive")
    run = gh_json("api", f"repos/{repository}/actions/runs/{args.run}")
    require(run["status"] == "completed" and run["conclusion"] == "success",
            "proxy CI must finish successfully before its image can be imported")
    require(run["event"] == "push" and run["head_branch"] == "main"
            and run["path"] == ".github/workflows/ci.yml", "unexpected publishing workflow or ref")
    require(run["repository"]["full_name"].lower() == repository.lower(), "unexpected run repository")
    commit = run["head_sha"]
    require(matches(commit, r"[0-9a-f]{40}"), "invalid source commit")
    with tempfile.TemporaryDirectory(prefix="hiro-image-") as directory:
        artifact = f"hiro-proxy-image-{commit}-{run['run_attempt']}"
        subprocess.run(["gh", "run", "download", str(args.run), "--repo", repository,
                        "--name", artifact, "--dir", directory], check=True)
        path = Path(directory)
        verify(str(path / "images.lock.json"), repository, commit,
               path / "images.lock.sigstore.json")
        published = json.loads((path / "images.lock.json").read_text())
        require(published.get("schema") == 1 and set(published["services"]) == {"hiro-proxy"},
                "unexpected published lock schema/services")
        image = published["services"]["hiro-proxy"]
        require(image["image"] == expected["image"] and
                image["source_repository"].lower() == repository.lower(), "published image identity mismatch")
        require(image["source_commit"] == commit and image["workflow_commit"] == commit
                and image["source_ref"] == "refs/heads/main"
                and image["build_workflow"] == ".github/workflows/ci.yml", "published build identity mismatch")
        require(matches(image["digest"], r"sha256:[0-9a-f]{64}"), "invalid OCI digest")
        verify("oci://" + image["image"] + "@" + image["digest"], repository, commit)
        lock["services"]["hiro-proxy"] = image
        # Both the metadata artifact and OCI provenance have now been verified.
        temporary = ROOT / "images.lock.json.tmp"
        try:
            write(temporary, lock)
            temporary.replace(ROOT / "images.lock.json")
        finally:
            temporary.unlink(missing_ok=True)
    print(f"Locked {image['image']}@{image['digest']}")


if __name__ == "__main__":
    try:
        main()
    except (ValueError, KeyError, OSError, subprocess.CalledProcessError) as error:
        print(f"error: {error}", file=sys.stderr)
        sys.exit(1)
