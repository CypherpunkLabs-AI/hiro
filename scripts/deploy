#!/usr/bin/env python3
"""Verify the locked stack, render it, and deploy through the official Phala CLI."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys
import tempfile
import time
import tomllib
import urllib.error
from urllib.parse import quote, urlsplit

import yaml

from hiro import ROOT, matches, rendered, require, write
from phala_api import query


def verify_cli_version(reported, expected):
    # Phala prints v<package-version>+<build-commit>, not bare semver.
    version = re.fullmatch(r"v?(\d+\.\d+\.\d+)(?:\+[0-9a-f]{7,40})?", reported.strip())
    require(version is not None and version.group(1) == expected,
            f"installed Phala CLI differs from --cli-version: {reported[:100]!r}")


def existing_cvm(name):
    try:
        info = query("cvms/" + quote(name, safe=""))
    except urllib.error.HTTPError as error:
        if error.code == 404:
            return None
        raise
    require(info.get("name") == name, "Phala returned a different named CVM")
    cvm_id = info.get("vm_uuid") or info.get("id")
    require(matches(cvm_id, r"[A-Za-z0-9_-]{1,128}"), "Phala returned an invalid existing CVM ID")
    return cvm_id


def cli_diagnostic(result, env_text):
    text = result.stderr or result.stdout
    values = [os.environ.get("PHALA_CLOUD_API_KEY", "")]
    for line in env_text.splitlines():
        if line.strip() and not line.lstrip().startswith("#") and "=" in line:
            value = line.split("=", 1)[1].strip().strip("\"'")
            values.append(value)
            if "://" in value:
                parsed = urlsplit(value)
                values.extend((parsed.username or "", parsed.password or ""))
    for value in sorted(set(values), key=len, reverse=True):
        if value:
            text = text.replace(value, "[redacted]")
    return text[-4000:]


def invoke_deployment(command, project):
    # Phala treats phala.toml's name as an existing-CVM selector. Keep the
    # repository's deployment name out of its implicit ID resolution.
    with tempfile.TemporaryDirectory(prefix="hiro-phala-") as directory:
        config = {key: project[key] for key in ("gateway_port", "gateway_domain") if key in project}
        Path(directory, "phala.toml").write_text("".join(f"{key} = {json.dumps(value)}\n" for key, value in config.items()))
        return subprocess.run(command, capture_output=True, text=True, cwd=directory, timeout=900)


def capture_composition(cvm_id, compose):
    """Preserve Phala's exact measured JSON; never reserialize before hashing."""
    for attempt in range(12):
        result = subprocess.run(["phala", "cvms", "attestation", cvm_id, "--json"],
                                capture_output=True, text=True, timeout=60)
        if result.returncode == 0:
            require(len(result.stdout.encode()) <= 4 * 1024 * 1024, "Phala attestation response exceeds limit")
            report = json.loads(result.stdout)
            if report.get("success") is True and "data" in report:
                report = report["data"]
            tcb = report.get("tcb_info") or {}
            raw = tcb.get("app_compose")
            if isinstance(raw, str) and raw:
                data = raw.encode()
                require(len(data) <= 256 * 1024, "Phala application composition exceeds limit")
                app = json.loads(raw)
                require(yaml.safe_load(app["docker_compose_file"]) == compose,
                        "deployed composition differs from the verified locked stack")
                (ROOT / "dist/app-compose.json").write_bytes(data)
                return hashlib.sha256(data).hexdigest()
        if attempt < 11:
            time.sleep(5)
    raise ValueError("CVM was provisioned but Phala has not supplied its measured composition; deployment.json records its ID")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--env", required=True, type=Path, help="application-only confidential env file")
    parser.add_argument("--image", required=True, help="reviewed production dstack OS image")
    parser.add_argument("--instance-type", required=True)
    parser.add_argument("--region", required=True)
    parser.add_argument("--cli-version", required=True, help="exact installed Phala CLI version")
    parser.add_argument("--node-id")
    parser.add_argument("--cvm-id", help="update this existing CVM instead of creating one")
    parser.add_argument("--check", action="store_true", help="verify and render without invoking deployment")
    args = parser.parse_args()
    require(matches(args.cli_version, r"\d+\.\d+\.\d+"), "pin a stable Phala CLI version")
    env_file = args.env.resolve(strict=True)
    require(env_file.is_file(), "application env file must be a regular file")
    # Do not upload the Cloud control-plane token with the application's secrets.
    env_text = env_file.read_text()
    require(not re.search(r"(?m)^\s*(?:export\s+)?PHALA_CLOUD_[A-Z_]+\s*=", env_text),
            "Cloud API credentials belong in the operator environment, not the uploaded env file")
    for setting in ("DEBUG", "NODE_DEBUG"):
        require(not os.environ.get(setting), f"unset {setting} before deploying confidential settings")
    compose = rendered()
    output = ROOT / "dist/compose.yaml"
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(yaml.safe_dump(compose, sort_keys=False))
    subprocess.run([sys.executable, str(ROOT / "scripts/verify-images")], check=True, cwd=ROOT)
    # Docker validates interpolation and Compose semantics without contacting a daemon.
    # Its quiet mode prevents decrypted settings from entering output/artifacts.
    subprocess.run(["docker", "compose", "--env-file", str(env_file), "-f", str(output),
                    "config", "--quiet"], check=True, cwd=ROOT)
    version = subprocess.check_output(["phala", "--version"], text=True).strip()
    verify_cli_version(version, args.cli_version)
    project = tomllib.loads((ROOT / "phala.toml").read_text())
    cvm_id = args.cvm_id or project.get("cvm_id")
    require(cvm_id is None or matches(cvm_id, r"[A-Za-z0-9_-]{1,128}"), "invalid configured CVM ID")
    if cvm_id is None and not args.check:
        cvm_id = existing_cvm(project["name"])
        if cvm_id:
            print(f"Updating existing named CVM {cvm_id}", flush=True)
    command = ["phala", "deploy", "--compose", str(output), "--name", project["name"],
               "--image", args.image, "--instance-type", args.instance_type, "--region", args.region,
               "--kms", "phala", "--env", str(env_file), "--no-dev-os", "--no-public-logs",
               "--no-public-sysinfo", "--wait", "--json"]
    if args.node_id:
        command.extend(["--node-id", args.node_id])
    if cvm_id:
        command.extend(["--cvm-id", cvm_id])
    print(shlex.join(command), flush=True)
    if not args.check:
        result = invoke_deployment(command, project)
        require(result.returncode == 0,
                "Phala deployment failed; inspect the CVM before retrying creation. " + cli_diagnostic(result, env_text))
        require(len(result.stdout.encode()) <= 1024 * 1024, "Phala deployment result exceeds limit")
        deployed = json.loads(result.stdout)
        require(deployed.get("success") is True, "Phala did not confirm deployment")
        app_id = deployed["app_id"].removeprefix("0x")
        require(matches(app_id, r"[0-9a-f]{40}"), "Phala returned an invalid application ID")
        cvm_id = deployed["vm_uuid"]
        require(matches(cvm_id, r"[A-Za-z0-9_-]{1,128}"), "Phala returned an invalid CVM ID")
        public = {"schema": 1, "cvm_id": cvm_id, "app_id": app_id,
                  "os_image": args.image, "instance_type": args.instance_type, "region": args.region}
        # Save the ID before awaiting attestation, so retries can update this CVM.
        write("dist/deployment.json", public)
        public["compose_sha256"] = capture_composition(cvm_id, compose)
        write("dist/deployment.json", public)
        print(f"Provisioned CVM {cvm_id}; measured composition {public['compose_sha256']}")


if __name__ == "__main__":
    try:
        main()
    except (ValueError, KeyError, OSError, TypeError, subprocess.SubprocessError, yaml.YAMLError) as error:
        print(f"error: {error}", file=sys.stderr)
        sys.exit(1)
