#!/usr/bin/env python3
"""List every unconfigured repository input for deployment, without reading secrets."""
import argparse
import sys

from hiro import ROOT, read, runtime_inputs, validate

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--bootstrap", action="store_true", help="allow an empty release list before first CVM boot")
args = parser.parse_args()
missing = []
try:
    lock, _ = validate()
    for name, entry in lock["services"].items():
        for field, value in entry.items():
            if value is None:
                missing.append(f"images.lock.json: {name}.{field} (import the successful proxy CI run)")
    for filename in ("verifier.json", "sigstore-roots.json"):
        if not (ROOT / "trust" / filename).is_file():
            missing.append(f"trust/{filename} (scripts/prepare-trust)")
    for field, value in read("trust/runtime.json").items():
        if value is None:
            missing.append(f"trust/runtime.json: {field}")
    for filename, key in (("platforms.json", "platforms"), ("kms.json", "kms")):
        if not read("trust/" + filename)[key]:
            missing.append(f"trust/{filename}: reviewed {key} approvals")
    if not args.bootstrap and not read("trust/policy.json")["approved_releases"]:
        missing.append("trust/policy.json: approved signed-release digest")
    if all((ROOT / "trust" / name).is_file() for name in ("verifier.json", "sigstore-roots.json")):
        try:
            runtime_inputs()
        except (ValueError, KeyError, OSError, TypeError) as error:
            missing.append(str(error))
except (ValueError, KeyError, OSError, TypeError) as error:
    missing.append(str(error))

if missing:
    print("Unconfigured deployment inputs:")
    for item in missing:
        print("- " + item)
    sys.exit(1)
print("Repository inputs are populated. Signed-artifact verification and live SDK acceptance remain runtime checks.")
