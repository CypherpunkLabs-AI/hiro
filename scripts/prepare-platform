#!/usr/bin/env python3
"""Verify platform evidence against independently reviewed identities and install public policy entries."""
import argparse
import json
from pathlib import Path
import subprocess
import tempfile

from hiro import ROOT, read, require, write


def upsert(path, key, value):
    document = read(path)
    entries = document[key]
    previous = next((entry for entry in entries if entry["id"] == value["id"]), None)
    require(previous is None or previous == value,
            "profile ID already identifies different evidence; use a new versioned ID")
    if previous is None:
        entries.append(value)
    write(path, document)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--verifier", required=True, type=Path, help="built hiro-proxy binary containing the pinned dstack verifier")
    parser.add_argument("--evidence", required=True, type=Path)
    parser.add_argument("--expected", required=True, type=Path, help="reviewed OS, app and compose identities; see trust/README.md")
    args = parser.parse_args()
    with tempfile.TemporaryDirectory(prefix="hiro-platform-") as directory:
        output = Path(directory) / "verified.json"
        subprocess.run([str(args.verifier.resolve(strict=True)), "prepare-platform", str(args.evidence.resolve()),
                        str(args.expected.resolve()), str(output)], check=True, cwd=ROOT)
        verified = json.loads(output.read_bytes())
        require(verified["schema"] == 1, "unsupported verified profile")
        upsert("trust/platforms.json", "platforms", verified["platform"])
        if verified.get("kms"):
            upsert("trust/kms.json", "kms", verified["kms"])
        write("dist/verified-platform.json", verified)
        print("Installed cryptographically verified platform policy for the supplied reviewed identities.")


if __name__ == "__main__":
    main()
