# Application variables only. Copy to .env for Phala's encrypted env upload.
# scripts/render-compose never expands these values into public release artifacts.
# PHALA_CLOUD_API_KEY belongs in the operator's shell/CI secrets, never this file.
# OS image, instance, region and CLI version are explicit scripts/deploy arguments.
# Subject, worker URLs and verifier trust are embedded from trust/ at render time.
AUTH_ISSUER=
AUTH_AUTHORIZED_PARTIES=
AUTH_JWKS_URL=
AUTH_JWT_KEY=
AUTH_AUDIENCE=
DATABASE_URL=
DATABASE_MAX_CONNECTIONS=20
CACHE_NAMESPACE_KEY=
INFERENCE_SYSTEM_PROMPT=
INFERENCE_TEMPERATURE=0.7
INFERENCE_MAX_TOKENS=32000
INFERENCE_MAX_CONCURRENCY=1000
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_USAGE_QUEUE_ID=
CLOUDFLARE_QUEUES_API_TOKEN=
USAGE_HMAC_SECRET=
PHALA_ACI_BASE_URL=
PHALA_API_KEY=
PHALA_ACI_ACCEPTED_SUBJECTS=
PHALA_ACI_ACCEPTED_KMS_ROOT_KEYS=
PHALA_ACI_PCCS_URL=
# Registry authentication is configured through Phala's private registry support.
# The evidence worker produces /run/hiro-evidence/evidence.json automatically.
