# Template for secrets.env on the separate hiro-config disk; never embedded in the OS.
# Public dummy values for CI/startup testing, incapable of serving application traffic.
# Values are literal: do not wrap them in quotes or use shell variable expansion.
# Public endpoint and trust policy is measured from runtime-policy.json.
DATABASE_URL=postgres://dummy:dummy@127.0.0.1:1/hiro?sslmode=verify-full
CACHE_NAMESPACE_KEY=public-dummy-cache-namespace-not-a-secret
PHALA_API_KEY=public-dummy-not-a-credential
CLOUDFLARE_QUEUES_API_TOKEN=public-dummy-not-a-credential
USAGE_HMAC_SECRET=public-dummy-usage-hmac-key-not-a-secret
